# CARTO basemap key for deployed maps. Without it, local development falls back to OSM tiles.
# Request a key at https://carto.com/basemaps/apikey and restrict it to your production origin.
VITE_CARTO_BASEMAP_KEY=
VITE_GOOGLE_CLIENT_ID=
# For QR passports, set this to the origin reachable by the people scanning them.
# Mobile Google sign-in requires a registered HTTPS hostname; raw LAN IPs are rejected by Google.
VITE_PUBLIC_APP_URL=
