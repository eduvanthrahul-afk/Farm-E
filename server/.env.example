# Server
PORT=5000
NODE_ENV=development

# MongoDB (transactions require a replica set; Atlas qualifies. Local demo mode persists in server/.local-mongo.)
MONGO_URI=mongodb://localhost:27017/farme?retryWrites=false
# Set true to use the embedded replica set; its files persist in server/.local-mongo. Local Mongo is preferred.
# Set MONGO_MEMORY_DB_PATH to use a different persistent folder.
MONGO_MEMORY=false

# Optional local demo fixture. Set DEMO_PASSWORD (12+ chars) before enabling.
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
# Generate a separate random secret of at least 32 bytes for signed QR batch records.
TRACE_SIGNING_SECRET=your_trace_signing_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Identity Services client ID (same OAuth web client ID as VITE_GOOGLE_CLIENT_ID in client/.env.local)
GOOGLE_CLIENT_ID=

# Optional Redis for shared rate-limit counters when running more than one API instance.
# If omitted, a bounded in-process counter is used (appropriate for the single free demo service).
REDIS_URL=

# CORS (comma-separated exact origins; production must use HTTPS)
CORS_ORIGIN=http://localhost:5173

# File Storage (local in development; production deploy uses durable R2 object storage)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Payment (mock by default)
PAYMENT_PROVIDER=mock

# Maps (mock by default)
MAPS_PROVIDER=mock
# OSRM-compatible routing service. The public OSRM demo is best-effort; use a hosted or self-managed service for production.
ROUTING_BASE_URL=https://router.project-osrm.org

# Notifications
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
# Set SMS_PROVIDER=twilio and configure these values to text farmers on new orders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Logging
LOG_LEVEL=debug
